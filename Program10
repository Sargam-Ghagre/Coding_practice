import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        int temp = n;
        int binary = 0;
        int pow = 1;

        while (temp > 0) {
            int rem = temp % 2;
            binary += rem * pow;
            pow *= 10;
            temp /= 2;
        }

        int rev = 0;
        int copy = binary;

        while (copy > 0) {
            int rem = copy % 10;
            rev = rev * 10 + rem;
            copy /= 10;
        }

        if (binary == rev) {
            System.out.println("Binary Palindrome");
        } else {
            System.out.println("Not Binary Palindrome");
        }
    }
}


import java.util.*;

public class BinaryPalindromeChecker {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int x = sc.nextInt();

        int original = x;
        int reversed = 0;

        while (x > 0) {

            reversed <<= 1;       // Left shift reversed
            reversed |= (x & 1);  // Add last bit of x
            x >>= 1;              // Right shift x
        }

        if (reversed == original) {
            System.out.println(original + " has a binary palindrome representation.");
        } else {
            System.out.println(original + " does not have a binary palindrome representation.");
        }
    }
}
