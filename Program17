class Main {
    public static void main(String[] args) {
        String s = "abc-bcb-cb-aa-bc";
        char[] str = s.toCharArray();

        int count = s.length() - 1;
        int i = s.length() - 1;

        while (i >= 0) {
            if (str[i] != '-') {
                str[count] = str[i];
                count--;
                i--;
            } else {
                i--;
            }
        }

        // Put hyphens at the beginning
        while (count >= 0) {
            str[count] = '-';
            count--;
        }

        System.out.println(new String(str));
    }
}
