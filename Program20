import java.util.*;

class PLA {

    public String lexicographicallyFirstPalindromicString(String str) {

        int freq[] = new int[26];

        for (int i = 0; i < str.length(); i++) {
            freq[str.charAt(i) - 'a']++;
        }

        int count = 0;

        for (int i = 0; i < freq.length; i++) {
            if (freq[i] % 2 != 0) {
                count++;
            }

            if (count > 1) {
                return "A palindrome cannot be formed";
            }
        }

        String firstpart = "";
        String middlepart = "";
        String endpart = "";

        for (int i = 0; i < freq.length; i++) {

            if (freq[i] % 2 != 0) {
                middlepart += (char)(i + 'a');
                freq[i]--;
            }
        }

        for (int i = 0; i < freq.length; i++) {

            while (freq[i] > 0) {
                firstpart += (char)(i + 'a');
                endpart = (char)(i + 'a') + endpart;
                freq[i] -= 2;
            }
        }

        return firstpart + middlepart + endpart;
    }
}

public class Main {

    public static void main(String[] args) {

        PLA pla = new PLA();

        System.out.println(
            pla.lexicographicallyFirstPalindromicString("mlayalaam")
        );
    }
}
