import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        String num = Integer.toBinaryString(n);

        int curr = 0;
        int prev = 0;
        int max = 0;

        for (int i = 0; i < num.length(); i++) {

            if (num.charAt(i) == '1') {
                curr++;
            } else {
                prev = curr;
                curr = 0;
            }

            max = Math.max(max, prev + curr + 1);
        }
        
        max = Math.min(max, num.length());

        System.out.println(max);
    }
}


import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        int curr = 0;
        int prev = 0;
        int max = 0;

        while (n > 0) {

            if ((n & 1) == 1) {
                curr++;
            } else {
                prev = curr;
                curr = 0;
            }

            max = Math.max(max, prev + curr + 1);

            n = n >> 1;
        }

        System.out.println(max);
    }
}
