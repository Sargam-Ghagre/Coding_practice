import java.util.*;

class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] a = new int[n];

        for (int i = 0; i < n; i++)
            a[i] = sc.nextInt();

        int candidate = 0, count = 0;

        for (int i = 0; i < n; i++) {
            if (count == 0)
                candidate = a[i];

            if (a[i] == candidate)
                count++;
            else
                count--;
        }

        // Verify candidate
        count = 0;

        for (int x : a) {
            if (x == candidate)
                count++;
        }

        if (count > n / 2)
            System.out.println(candidate);
        else
            System.out.println("No Majority Element");
    }
}
