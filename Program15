import java.util.*;

class Main {
    public static void main(String[] args) {

        int[] array = {16, 17, 4, 3, 5, 2};

        int n = array.length;
        int max = array[n - 1];

        System.out.print(max + " ");

        for (int i = n - 2; i >= 0; i--) {
            if (array[i] > max) {
                max = array[i];
                System.out.print(max + " ");
            }
        }
    }
}
