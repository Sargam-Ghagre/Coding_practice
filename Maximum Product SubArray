class Main {
    public static void main(String[] args) {

        int[] nums = {6, 3, -2, 4, -1, 7, -1, 5};

        int prefix = Integer.MIN_VALUE;
        int suffix = Integer.MIN_VALUE;

        int prefProd = 1;
        int sufProd = 1;

        int n = nums.length;
        int ans = Integer.MIN_VALUE;

        for (int i = 0; i < n; i++) {

            if (prefProd == 0)
                prefProd = 1;

            if (sufProd == 0)
                sufProd = 1;

            prefProd *= nums[i];
            sufProd *= nums[n - 1 - i];

            prefix = Math.max(prefix, prefProd);
            suffix = Math.max(suffix, sufProd);

            ans = Math.max(ans, Math.max(prefix, suffix));
        }

        System.out.println("Maximum Product = " + ans);
    }
}




import java.util.*;

class Main {
    public static void main(String[] args) {

        int[] a = {6, 3, -2, 4, -1, 7, -1, 5};

        int pre = 1, suf = 1, ans = Integer.MIN_VALUE;
        int n = a.length;

        for (int i = 0; i < n; i++) {

            if (pre == 0) pre = 1;
            if (suf == 0) suf = 1;

            pre *= a[i];
            suf *= a[n - 1 - i];

            ans = Math.max(ans, Math.max(pre, suf));
        }

        System.out.println(ans);
    }
}
