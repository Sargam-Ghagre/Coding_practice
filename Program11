import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        String num = Integer.toBinaryString(n);

        int c = 0;
        int m = 0;

        for (int i = 0; i < num.length(); i++) {
            if (num.charAt(i) == '1') {
                c++;
                if (c > m) {
                    m = c;
                }
            } else {
                c = 0;
            }
        }

        System.out.println(m);
    }
}
